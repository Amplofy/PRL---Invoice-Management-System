# PRL-EOMS Frontend Environment Variables
# Copy to .env and fill in real values

# Backend API base URL (empty for same-origin via Vite proxy in dev)
VITE_API_URL=

# Supabase project URL + anon key (for client-side auth).
# Leave empty if you only want the demo preview.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Demo mode is NOT configured via env vars — it is triggered by the
# "Explore the live demo" button on the login page. The demo runs fully
# offline against an in-memory mock API (frontend/src/lib/mockApi.ts) and
# never touches real data. Real users sign in normally with the form above it.
